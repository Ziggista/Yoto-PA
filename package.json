{
  "name": "yoto-pa",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "android:override-settings": "node scripts/override-capacitor-settings.mjs",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android && npm run android:override-settings",
    "android:open": "npx cap open android",
    "android:apk:debug": "npm run build && npx cap sync android && npm run android:override-settings && powershell -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@exxili/capacitor-nfc": "^0.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@aparajita/capacitor-secure-storage": "^8.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
